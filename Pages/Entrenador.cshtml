@page
@model EntrenadorModel
@{
    ViewData["Title"] = "Entrenador";
}

<div class="card">
    <div class="card-header encabezado">
        <h2 class="mt-1"><i class="bi bi-clipboard me-2"></i>Entrenadores</h2>
    </div>
    <div class="card-body">

        <!-- Aviso con el mensaje del SP -->
        @if (Model.Mensaje != "")
        {
            <div class="alert alert-@Model.TipoMensaje">@Model.Mensaje</div>
        }

        <!-- Formulario registrar / editar (sólo ADMINISTRADOR) -->
        @if (Model.EsAdministrador)
        {
            <form method="post" asp-page-handler="Guardar" class="mb-4">
                <input type="hidden" asp-for="Entrenador.IdEntrenador" />

                <div class="row g-2">
                    <div class="col-md-4">
                        <label asp-for="Entrenador.Nombre" class="form-label">Nombre</label>
                        <input asp-for="Entrenador.Nombre" class="form-control" maxlength="80" required />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Entrenador.PrimerApellido" class="form-label">Primer apellido</label>
                        <input asp-for="Entrenador.PrimerApellido" class="form-control" maxlength="80" required />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Entrenador.SegundoApellido" class="form-label">Segundo apellido</label>
                        <input asp-for="Entrenador.SegundoApellido" class="form-control" maxlength="80" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Entrenador.FechaNacimiento" class="form-label">Fecha de nacimiento</label>
                        <input asp-for="Entrenador.FechaNacimiento" type="date" class="form-control"
                               max="@DateTime.Today.AddDays(-1).ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Entrenador.Cedula" class="form-label">Cédula</label>
                        <input asp-for="Entrenador.Cedula" class="form-control" maxlength="50" required />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Entrenador.Telefono" class="form-label">Teléfono</label>
                        <input asp-for="Entrenador.Telefono" type="tel" class="form-control" maxlength="15"
                               pattern="[0-9]{10,15}" title="Sólo números, de 10 a 15 dígitos" required />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Entrenador.IdEquipo" class="form-label">Equipo</label>
                        <select asp-for="Entrenador.IdEquipo" class="form-select" required>
                            <option value="">Selecciona un equipo</option>
                            @foreach (DataRow equipo in Model.Equipos.Rows)
                            {
                                <option value="@equipo["Id"]">@equipo["Equipo"] (@equipo["Categoria"])</option>
                            }
                        </select>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary mt-3">
                    @(Model.Entrenador.IdEntrenador == 0 ? "Registrar" : "Guardar cambios")
                </button>

                @if (Model.Entrenador.IdEntrenador != 0)
                {
                    <a asp-page="Entrenador" class="btn btn-secondary mt-3">Cancelar</a>
                }
            </form>
        }

        <!-- Búsqueda por nombre, cédula, teléfono o equipo -->
        <form method="get" class="d-flex mb-3">
            <input name="Buscar" value="@Model.Buscar" class="form-control me-2" placeholder="Buscar por nombre, cédula, teléfono o equipo" />
            <button type="submit" class="btn btn-outline-primary">Buscar</button>
        </form>

        <!-- Tabla de entrenadores activos -->
        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Entrenador</th>
                        <th>Equipo</th>
                        <th>Categoría</th>
                        <th>Nacimiento</th>
                        <th>Edad</th>
                        <th>Cédula</th>
                        <th>Teléfono</th>
                        @if (Model.EsAdministrador)
                        {
                            <th></th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (DataRow fila in Model.Entrenadores.Rows)
                    {
                        var id = fila["Id"];
                        <tr>
                            <td>@fila["Entrenador"]</td>
                            <td>@fila["Equipo"]</td>
                            <td>@fila["Categoria"]</td>
                            <td>@fila["FechaNacimiento"]</td>
                            <td>@fila["Edad"]</td>
                            <td>@fila["Cedula"]</td>
                            <td>@fila["Telefono"]</td>
                            @if (Model.EsAdministrador)
                            {
                                <td class="text-nowrap">
                                    <a asp-page-handler="Editar" asp-route-id="@id" class="btn btn-sm btn-warning rounded-circle"><i class="bi bi-pencil"></i></a>

                                    <form method="post" asp-page-handler="Eliminar" asp-route-id="@id" class="d-inline"
                                          onsubmit="return confirm('¿Dar de baja a este entrenador?');">
                                        <button type="submit" class="btn btn-sm btn-danger rounded-circle"><i class="bi bi-trash"></i></button>
                                    </form>
                                </td>
                            }
                        </tr>
                    }
                    @if (Model.Entrenadores.Rows.Count == 0)
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted">No hay entrenadores para mostrar</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
