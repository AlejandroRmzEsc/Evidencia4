@page
@model InicioModel
@{
    ViewData["Title"] = "Inicio";
}

<div class="container welcome">
    <div class="welcome-box w-100">
        <div class="row align-items-center">
            <div class="col-md-7">
                <span class="welcome-tag">Programación distribuida</span>

                <h1>Sistema de torneo</h1>

                <p>
                    Asociación de futbol con ASP .NET Razor Pages y SQL Server.
                    @if (Model.EsAdministrador)
                    {
                        <text>Como administrador puedes registrar, editar y dar de baja.</text>
                    }
                    else
                    {
                        <text>Como observador puedes consultar la información.</text>
                    }
                </p>

                <a asp-page="/Jugador" class="btn btn-primary me-2"><i class="bi bi-person me-1"></i>Jugadores</a>
                <a asp-page="/Entrenador" class="btn btn-outline-primary"><i class="bi bi-clipboard me-1"></i>Entrenadores</a>
            </div>

            <div class="col-md-5 text-center">
                <div class="welcome-icon">
                    <i class="bi bi-trophy"></i>
                </div>
            </div>
        </div>
    </div>
</div>
